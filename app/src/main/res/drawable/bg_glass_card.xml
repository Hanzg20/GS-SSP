<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <layer-list>
            <!-- 1. Outer Glow/Border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_border" />
                </shape>
            </item>
            <!-- 2. Main Glass Background -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient
                        android:angle="135"
                        android:endColor="@color/glass_white_low"
                        android:startColor="@color/glass_white_high"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
