<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_custom_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Amount"
        android:textColor="@color/text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm_custom"
        app:layout_constraintTop_toBottomOf="@id/tv_custom_title"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp">

        <!-- Mechanical Flip Counter Container (Z-axis prioritized) -->
        <LinearLayout
            android:id="@+id/layout_flip_counter"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_plus"
            app:layout_constraintStart_toEndOf="@id/btn_minus"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$"
                android:textColor="@color/gold_accent"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <com.goldsky.ssp.view.FlipDigitView
                android:id="@+id/flip_tens"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp" />

            <com.goldsky.ssp.view.FlipDigitView
                android:id="@+id/flip_ones"
                android:layout_width="55dp"
                android:layout_height="match_parent" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/btn_neutral_bg"
            android:text="-"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/btn_neutral_bg"
            android:text="+"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_confirm_custom"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/royal_blue"
        android:text="CONFIRM &amp; PAY"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btn_cancel_custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_cancel_custom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="@color/btn_neutral_bg"
        android:text="CANCEL"
        android:textColor="@color/text_light"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
