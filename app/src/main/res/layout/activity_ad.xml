<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Looping video view -->
    <VideoView
        android:id="@+id/video_ad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone" />

    <!-- Fallback/Carousel Image View -->
    <ImageView
        android:id="@+id/img_ad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ad_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="visible" />

    <!-- Fullscreen Text Announcement: deliberately distinct from the video/image
         ad look (glass card panel + royal-blue "ANNOUNCEMENT" label + light,
         non-bold body text) rather than the amber/bold styling used by the
         promotional "touch to start" prompt below. -->
    <LinearLayout
        android:id="@+id/layout_announcement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_glass_card"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_announcement_label"
            android:textColor="@color/royal_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_announcement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_light"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            tools:text="Store closes early at 6pm today for maintenance." />

    </LinearLayout>

    <!-- Fullscreen Promotional Text Ad (TEXT_AD): distinct from TEXT
         (announcement), bold gold/amber promotional treatment matching the
         video/image ad branding (prompt_bg pill + shadowed gold text), no
         glass card, rather than the formal blue "ANNOUNCEMENT" notice look. -->
    <LinearLayout
        android:id="@+id/layout_text_ad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/prompt_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/ad_promo_label"
            android:textColor="@color/goldsky_gold_start"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_text_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/goldsky_gold_start"
            android:textSize="36sp"
            android:textStyle="bold"
            android:shadowColor="@color/bg_dark"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            tools:text="This weekend only: 20% off all wash packages!" />

    </LinearLayout>

    <!-- Overlay Brand Slogan -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@color/scrim_light"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_goldsky_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="GS-SSP"
            android:textColor="@color/goldsky_gold_start"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By GoldSky Technologies"
            android:textColor="@color/text_light"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Pause/resume control for the current ad or announcement. Deliberately
         a small corner control, not a full-screen gesture: the rest of the
         screen must keep working as the "tap to start a wash" CTA, so this
         can't compete with that for touch area. -->
    <ImageView
        android:id="@+id/btn_pause_ad"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:padding="14dp"
        android:background="@drawable/bg_control_button"
        android:src="@drawable/ic_pause"
        android:contentDescription="@string/ad_pause_content_description"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Interactive Prompt: pill badge (prompt_bg) rather than bare
         floating text, so it reads as a deliberate call-to-action distinct
         from both the ad content behind it and the announcement card above. -->
    <TextView
        android:id="@+id/tv_ad_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:background="@drawable/prompt_bg"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/ad_prompt"
        android:textColor="@color/goldsky_gold_start"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
