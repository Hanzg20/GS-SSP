<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#051626">

    <View
        android:id="@+id/view_status_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFB800" />

    <!-- 1. CARD GUIDANCE VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_card_guidance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/shared_subtitle"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#0A2436"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_back_pay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:text="@string/btn_back"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="@id/header_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/header_bg" />

        <TextView
            android:id="@+id/tv_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/prompt_tap_card"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bg" />

        <ImageView
            android:id="@+id/img_contactless"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:src="@android:drawable/ic_dialog_map"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_card_title" />

        <View
            android:id="@+id/device_outline"
            android:layout_width="140dp"
            android:layout_height="200dp"
            android:background="@drawable/card_brand_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_contactless" />

        <androidx.cardview.widget.CardView
            android:id="@+id/animated_card"
            android:layout_width="90dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="#00D1FF"
            app:cardCornerRadius="4dp"
            app:cardElevation="10dp"
            app:layout_constraintBottom_toBottomOf="@id/device_outline"
            app:layout_constraintEnd_toEndOf="@id/device_outline"
            app:layout_constraintStart_toStartOf="@id/device_outline"
            app:layout_constraintTop_toTopOf="@id/device_outline"
            app:layout_constraintVertical_bias="0.8">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_info_details" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. QR SCAN VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_qr_guidance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/shared_subtitle"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/btn_back"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_pay_qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_qr_guide"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_pay_qr" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/shared_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Total: $10.00"
        android:textColor="#FFB800"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/pb_pay_timeout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/pb_pay_timeout"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="60"
        android:progress="60"
        android:progressTint="#00D1FF"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Final Success Background (Hidden by default) -->
        <View
            android:id="@+id/view_final_success_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2E7D32"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_status"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/status_processing"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lottie_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
