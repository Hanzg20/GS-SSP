<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.goldsky.ssp.aegis.wash">

    <!-- Permissions for internet and payment status polling -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission for PAX scanner hardware -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permission for boot autostart (Kiosk mode) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- PAX Hardware Access Permissions -->
    <uses-permission android:name="com.pax.permission.ICC" />
    <uses-permission android:name="com.pax.permission.PICC" />
    <uses-permission android:name="com.pax.permission.MAGCARD" />
    <uses-permission android:name="com.pax.permission.PED" />
    <uses-permission android:name="com.pax.permission.PRINTER" />
    <uses-permission android:name="com.pax.permission.REBOOT" />
    <uses-permission android:name="com.pax.permission.IO_CONTROL" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- WizarPOS Hardware Access Permissions -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CLOUDPOS_MSR" />
    <uses-permission android:name="android.permission.CLOUDPOS_PRINTER" />
    <uses-permission android:name="android.permission.CLOUDPOS_SMARTCARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_CONTACTLESS_CARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_SCANNER" />
    <uses-permission android:name="android.permission.CLOUDPOS_SERIAL" />
    <uses-permission android:name="android.permission.CLOUDPOS_LED" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_GET_PIN_BLOCK" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_MAC" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_ENCRYPT_DATA" />
    <uses-permission android:name="android.permission.CLOUDPOS_SAFE_MODULE" />
    <uses-permission android:name="android.permission.CLOUDPOS_INNER_GPIO" />
    <uses-permission android:name="android.permission.CLOUDPOS_VIRTUAL_SERIAL_PORT" />
    <uses-permission android:name="android.permission.CLOUDPOS_MCUCTL" />

    <!-- Required for POSLink AIDL to bind BroadPOS, and for the CloudPOS
         Advance SDK's scanner (ScannerAdvanceDeviceImpl) to resolve its
         com.cloudpos.scanserver service package, on targetSdkVersion >= 30.
         Android's package-visibility filtering hides both from this app by
         default (confirmed on real WizarPOS Q3mini hardware 2026-09-18:
         scanning failed with "No such package: com.cloudpos.scanserver"
         until this entry was added, even though the service is genuinely
         installed on-device; AppsFilter logs showed the interaction as
         BLOCKED). -->
    <queries>
        <intent>
            <action android:name="com.pax.us.std.poslink.aidl" />
        </intent>
        <package android:name="com.cloudpos.scanserver" />
        <!-- WizarPosHoneywellScannerProvider binds this app's MainService
             directly to drive the bottom hardware scan engine. -->
        <package android:name="com.wizarpos.honeywell.scanner" />
    </queries>

    <!-- ID TECH NEO2 connects as a USB host peripheral -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".AegisWashApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GoldSky Aegis Wash"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSP"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- FileProvider for secure cross-process media access -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Boot receiver for Autostart -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Wash flow's MainActivity (feature:wash), secondary entry point -->
        <activity
            android:name="com.goldsky.ssp.feature.wash.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="com.goldsky.ssp.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- New Splash Screen as the main LAUNCHER -->
        <activity
            android:name="com.goldsky.ssp.ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSP.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.goldsky.ssp.ui.AdActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSP.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name="com.goldsky.ssp.ui.VipActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSP.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize" />

    </application>

</manifest>
