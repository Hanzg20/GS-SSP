<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.goldsky.ssp.aegis.flex">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- BootFrontGuard / KioskRecall bring the kiosk back over OPC after a boot: Android 14 only
         lets a background start through with "display over other apps" (see aegis-timer). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- WizarPOS: card payment + ext board; same set as aegis-vend / aegis-timer -->
    <uses-permission android:name="android.permission.CLOUDPOS_MSR" />
    <uses-permission android:name="android.permission.CLOUDPOS_SMARTCARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_CONTACTLESS_CARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_LED" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_GET_PIN_BLOCK" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_MAC" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_ENCRYPT_DATA" />
    <uses-permission android:name="android.permission.CLOUDPOS_SAFE_MODULE" />
    <uses-permission android:name="android.permission.CLOUDPOS_INNER_GPIO" />
    <uses-permission android:name="android.permission.CLOUDPOS_MCUCTL" />
    <uses-permission android:name="android.permission.CLOUDPOS_SERIAL" />
    <uses-permission android:name="android.permission.CLOUDPOS_VIRTUAL_SERIAL_PORT" />
    <!-- WizarPOS system extension: setting the boot launcher (LauncherClaim); both names, see aegis-timer -->
    <uses-permission android:name="android.permission.CLOUDPOS_DEFAULT_LAUNCHER" />
    <uses-permission android:name="android.permission.CLOUDPOS_SET_DEFAULT_LAUNCHER" />
    <!-- VIP member code payment: the camera scan, as Aegis Wash. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The CloudPOS scanner resolves its com.cloudpos.scanserver service package by name: hidden by
         Android's package-visibility filtering without this (as Vend, 2026-11-03). -->
    <queries>
        <package android:name="com.cloudpos.scanserver" />
        <package android:name="com.wizarpos.honeywell.scanner" />
    </queries>

    <application
        android:name=".AegisFlexApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="GoldSky Aegis Flex"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSP">

        <activity
            android:name="com.goldsky.ssp.flex.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Unattended kiosk: as HOME the terminal comes back into the sale screen
                 after a power cut by itself (same as Wash / Vend). The terminal's default
                 HOME is set when it's provisioned. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Idle ad screen, same as Wash / Vend. -->
        <activity
            android:name="com.goldsky.ssp.ui.AdActivity"
            android:exported="false"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.SSP.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize" />

    </application>
</manifest>
