<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets BootReceiver bring the kiosk back after a reboot: Android 14
         blocks background activity starts (BAL_BLOCK, seen on the Q3mini)
         unless the app holds "display over other apps". Must be granted once
         per terminal (Settings, TMS, or adb appops). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- PAX (same set as aegis-wash) -->
    <uses-permission android:name="com.pax.permission.ICC" />
    <uses-permission android:name="com.pax.permission.PICC" />
    <uses-permission android:name="com.pax.permission.MAGCARD" />
    <uses-permission android:name="com.pax.permission.PED" />
    <uses-permission android:name="com.pax.permission.REBOOT" />
    <uses-permission android:name="com.pax.permission.IO_CONTROL" />
    <!-- WizarPOS: card payment + ext-board (Digit IO) + MCU (same set as aegis-wash) -->
    <uses-permission android:name="android.permission.CLOUDPOS_MSR" />
    <uses-permission android:name="android.permission.CLOUDPOS_SMARTCARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_CONTACTLESS_CARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_LED" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_GET_PIN_BLOCK" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_MAC" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_ENCRYPT_DATA" />
    <uses-permission android:name="android.permission.CLOUDPOS_SAFE_MODULE" />
    <uses-permission android:name="android.permission.CLOUDPOS_INNER_GPIO" />
    <uses-permission android:name="android.permission.CLOUDPOS_MCUCTL" />
    <uses-permission android:name="android.permission.CLOUDPOS_SERIAL" />
    <uses-permission android:name="android.permission.CLOUDPOS_VIRTUAL_SERIAL_PORT" />
    <!-- WizarPOS system extension (WizarViewAgentAssistant): its
         checkPermission requires the caller to declare these AND be signed
         with a WizarPOS-issued certificate. Without the declaration reboot()
         was refused even with the WizarPOS cert (2026-09-28). -->
    <uses-permission android:name="android.permission.CLOUDPOS_REBOOT" />
    <uses-permission android:name="android.permission.CLOUDPOS_DEFAULT_LAUNCHER" />
    <!-- WizarViewAgentAssistant.setDefaultLauncher checks for this name (its
         error: "NO PERMISSION: ...CLOUDPOS_SET_DEFAULT_LAUNCHER") although the
         system defines CLOUDPOS_DEFAULT_LAUNCHER; declare both. -->
    <uses-permission android:name="android.permission.CLOUDPOS_SET_DEFAULT_LAUNCHER" />

    <!-- Package visibility for the payment apps/services the providers bind
         (see aegis-wash's manifest for the on-device evidence). -->
    <queries>
        <!-- LauncherClaim reads the current default HOME. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="com.pax.us.std.poslink.aidl" />
        </intent>
        <package android:name="com.cloudpos.scanserver" />
        <!-- AppSwitcher: technician switch to the other Aegis app. -->
        <package android:name="com.goldsky.ssp.aegis.wash" />
    </queries>

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Unattended kiosk: after a power cut the terminal must come back into
         the sale screen by itself. HOME is what actually does that on Android
         14 (background activity starts from a boot receiver are blocked);
         BootReceiver is the fallback for when another app is the default HOME.
         A unit with aegis-wash installed too (the bay5 test unit) will ask
         once which HOME to use; real sites run one app per terminal. -->
    <application
        android:name=".AegisTimerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Aegis Timer"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSP">

        <!-- singleTask: HOME presses must return to this one instance, never
             stack a second kiosk (two ViewModels = two payment sessions). -->
        <activity
            android:name="com.goldsky.ssp.feature.timer.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSP.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Idle ad screen, shared with aegis-wash (core/ui AdActivity). -->
        <activity
            android:name="com.goldsky.ssp.ui.AdActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSP.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- AdActivity plays downloaded ads through this (${applicationId}.fileprovider). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
