<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2A2414" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#FFB800" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:endColor="#121214" android:startColor="#202024" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#3A3A42" />
        </shape>
    </item>
</selector>
