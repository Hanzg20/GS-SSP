<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <layer-list>
            <!-- 1. Emerald Outer Glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/glow_green" />
                </shape>
            </item>
            <!-- 2. Deep Emerald Glass Body -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="135"
                        android:endColor="#DD064E3B"
                        android:startColor="#EE065F46"
                        android:type="linear" />
                </shape>
            </item>
            <!-- 3. Micro-Bevel Light -->
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#44FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
