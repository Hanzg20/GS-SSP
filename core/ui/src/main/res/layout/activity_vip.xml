<?xml version="1.0" encoding="utf-8"?>
<!--
  VIP membership page (redesigned 2026-10-06; 2026-10-21: the sample pass and the
  small benefit / how-it-works lines are gone, the plans fill the page 2 x 2).
  Plans are the merchant's vip_load_plans (item_vip_plan); offline / no plans,
  the how-to guide. The Q3mini gives the app only ~410dp of height on its
  480x480 screen, so everything is sized to that.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vip_page"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <Button
        android:id="@+id/btn_back_main"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/vip_surface_hi"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/vip_back_arrow"
        android:textColor="@color/text_light"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_vip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:letterSpacing="0.18"
        android:text="@string/vip_page_title"
        android:textColor="@color/gold_accent"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back_main"
        app:layout_constraintTop_toTopOf="@id/btn_back_main" />


    <!-- Load plans, 2 x 2 (filled by VipActivity), or the guide. The sample pass is gone:
         the plans are what the page is for. -->
    <LinearLayout
        android:id="@+id/layout_tiers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_vip_how"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_main" />

    <!-- No plans: the network is down (a top-up can't be credited without the server, and a
         card can't be charged either), or the store has none. Says which, offers nothing. -->
    <LinearLayout
        android:id="@+id/layout_vip_unavailable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_vip_tile"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_vip_how"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_main">

        <TextView
            android:id="@+id/tv_vip_unavailable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/vip_unavailable_title"
            android:textColor="@color/gold_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_vip_unavailable_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/vip_unavailable_body"
            android:textColor="@color/text_light"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- How it works, one line. -->
    <TextView
        android:id="@+id/tv_vip_how"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="@string/vip_how_it_works"
        android:visibility="gone"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
