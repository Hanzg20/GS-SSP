<?xml version="1.0" encoding="utf-8"?>
<!--
  VIP membership page (redesigned 2026-10-06). The VIP card is electronic:
  the member code is the card, so the hero is a drawn digital pass
  (VipCardView), not a photo of a plastic card.

  Left: the pass + three benefits. Right: the merchant's load plans as
  tiles (item_vip_plan, from vip_load_plans); or, offline / no plans, the
  how-to guide. Bottom: how it works. The Q3mini gives the app only ~410dp
  of height on its 480x480 screen, so everything is sized to that.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vip_page"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <Button
        android:id="@+id/btn_back_main"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/vip_surface_hi"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/vip_back_arrow"
        android:textColor="@color/text_light"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_vip_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:letterSpacing="0.18"
        android:text="@string/vip_page_title"
        android:textColor="@color/gold_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back_main"
        app:layout_constraintTop_toTopOf="@id/btn_back_main" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_mid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.48" />

    <!-- Left: the digital pass and what it gives you. -->
    <LinearLayout
        android:id="@+id/layout_vip_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/guide_mid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_main">

        <com.goldsky.ssp.ui.VipCardView
            android:id="@+id/vip_card_face"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp" />

        <TextView
            style="@style/VipBenefit"
            android:layout_marginTop="14dp"
            android:text="@string/vip_benefit_bonus" />

        <TextView
            style="@style/VipBenefit"
            android:text="@string/vip_benefit_digital" />

        <TextView
            style="@style/VipBenefit"
            android:text="@string/vip_benefit_scan" />
    </LinearLayout>

    <!-- Right: load plans (filled by VipActivity), or the guide. -->
    <LinearLayout
        android:id="@+id/layout_tiers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_vip_how"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guide_mid"
        app:layout_constraintTop_toBottomOf="@id/btn_back_main" />

    <LinearLayout
        android:id="@+id/layout_vip_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_vip_tile"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guide_mid"
        app:layout_constraintTop_toBottomOf="@id/btn_back_main">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/vip_guide_buy_title"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_vip_guide_buy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vip_guide_buy_body"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.1"
            android:text="@string/vip_guide_use_title"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/vip_guide_use_body"
            android:textColor="@color/text_light"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- How it works, one line. -->
    <TextView
        android:id="@+id/tv_vip_how"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="@string/vip_how_it_works"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
