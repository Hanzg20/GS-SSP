<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <View
        android:id="@+id/view_status_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/gold_accent" />

    <!-- 1. CARD GUIDANCE VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_card_guidance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/shared_subtitle"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_glass_card"
            android:alpha="0.9"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_back_pay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:text="@string/btn_back"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="@id/header_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/header_bg" />

        <TextView
            android:id="@+id/tv_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/prompt_tap_card"
            android:textColor="@color/text_light"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bg" />

        <ImageView
            android:id="@+id/img_contactless"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="32dp"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="@color/gold_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bg" />

        <!-- Pulsing Rings for Tap Area (Triple Ripple) -->
        <View
            android:id="@+id/view_tap_ring_1"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/ic_contactless_ring"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/device_outline"
            app:layout_constraintEnd_toEndOf="@id/device_outline"
            app:layout_constraintStart_toStartOf="@id/device_outline"
            app:layout_constraintTop_toTopOf="@id/device_outline"
            app:layout_constraintVertical_bias="0.8" />

        <View
            android:id="@+id/view_tap_ring_2"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/ic_contactless_ring"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/device_outline"
            app:layout_constraintEnd_toEndOf="@id/device_outline"
            app:layout_constraintStart_toStartOf="@id/device_outline"
            app:layout_constraintTop_toTopOf="@id/device_outline"
            app:layout_constraintVertical_bias="0.8" />

        <View
            android:id="@+id/view_tap_ring_3"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/ic_contactless_ring"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/device_outline"
            app:layout_constraintEnd_toEndOf="@id/device_outline"
            app:layout_constraintStart_toStartOf="@id/device_outline"
            app:layout_constraintTop_toTopOf="@id/device_outline"
            app:layout_constraintVertical_bias="0.8" />

        <View
            android:id="@+id/device_outline"
            android:layout_width="200dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_terminal_panel"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_contactless"
            app:layout_constraintVertical_bias="0.3" />

        <androidx.cardview.widget.CardView
            android:id="@+id/animated_card"
            android:layout_width="110dp"
            android:layout_height="70dp"
            app:cardBackgroundColor="@color/royal_blue"
            app:cardCornerRadius="8dp"
            app:cardElevation="15dp"
            app:layout_constraintBottom_toBottomOf="@id/device_outline"
            app:layout_constraintEnd_toEndOf="@id/device_outline"
            app:layout_constraintStart_toStartOf="@id/device_outline"
            app:layout_constraintTop_toTopOf="@id/device_outline"
            app:layout_constraintVertical_bias="0.9">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_info_details" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. QR SCAN VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_qr_guidance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/shared_subtitle"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/btn_back"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img_pay_qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_qr_guide"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_pay_qr" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/shared_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Total: $10.00"
        android:textColor="@color/gold_accent"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/pb_pay_timeout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/pb_pay_timeout"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="60"
        android:progress="60"
        android:progressTint="@color/royal_blue"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Water Drop Icon (Main focus during wash) -->
        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_water_drop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/status_processing"
            android:textColor="@color/text_light"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_status_icon" />

        <!--
           Hidden extra views (wv_status_bg, view_success_glass, rbv_status_brush)
           are removed or kept GONE to focus on the water drop.
        -->

        <!--
          Stage stepper: only shown while hardware pulses are actually being
          sent (see MainActivity.startFinalizationSequence). Progress and the
          stage label both driven by DispenseEngine's real onProgress
          callback, not a fixed timer: this is the actual "something is
          happening" evidence, the icon above is just the accompanying visual.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_wash_stepper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/bg_glass_card"
            android:padding="16dp"
            android:elevation="4dp"
            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_status_msg"
            android:layout_marginTop="32dp">

            <ProgressBar
                android:id="@+id/pb_wash_stages"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/gold_accent"
                android:progressBackgroundTint="@color/border_light"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_stage_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/pb_wash_stages"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Rinsing…" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
