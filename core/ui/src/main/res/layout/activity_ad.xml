<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- NEW: Transparent Click Catcher for "TAP TO PAY" (lowest Z-index) -->
    <View
        android:id="@+id/ad_bg_tap_handler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent" />

    <!-- Video ad, full screen: FillVideoView scales it to cover the 480x480
         screen (like the image's centerCrop). A FrameLayout holds it because
         it centres an oversized child (ConstraintLayout left it 35 px off,
         2026-10-08) and clips the overflow. It used to fit with black bars. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.goldsky.ssp.ui.FillVideoView
            android:id="@+id/video_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Fallback/Carousel Image View -->
    <ImageView
        android:id="@+id/img_ad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ad_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="visible" />

    <!-- Text announcement (TEXT) as a pinned notice board, text ad (TEXT_AD)
         as a backlit billboard (see SignboardView). Replaced the loose
         glass-card / gold-text panels (owner: "too casual", 2026-10-07). -->
    <com.goldsky.ssp.ui.SignboardView
        android:id="@+id/layout_announcement"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <com.goldsky.ssp.ui.SignboardView
        android:id="@+id/layout_text_ad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- Overlay Brand Slogan -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@color/scrim_light"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo and product name on one line -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/goldsky_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GSPAY-Aegis"
                android:textColor="@color/goldsky_gold_start"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="www.goldsky.ca"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

    </LinearLayout>

    <!-- Pause/resume control for the current ad or announcement. Deliberately
         a small corner control, not a full-screen gesture: the rest of the
         screen must keep working as the "tap to start a wash" CTA, so this
         can't compete with that for touch area.
         UPGRADED: 72dp for improved industrial ergonomics. -->
    <ImageView
        android:id="@+id/btn_pause_ad"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:padding="18dp"
        android:background="@drawable/bg_control_button"
        android:src="@drawable/ic_pause"
        android:contentDescription="@string/ad_pause_content_description"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Interactive Prompt: translucent amber pill (prompt_tap_bg)
         with dark navy text, so it reads as a deliberate call-to-action distinct
         from both the ad content behind it and the announcement card above. -->
    <TextView
        android:id="@+id/tv_ad_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:background="@drawable/prompt_tap_bg"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/ad_prompt"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
